{
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#54ae68",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#22a7f0",
          "name": "Secondary"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Black"
        },
        {
          "slug": "gray",
          "color": "#666666",
          "name": "Gray"
        },
        {
          "slug": "light-gray",
          "color": "#f5f5f5",
          "name": "Light Gray"
        }
      ]
    },
    "typography": {
      "fontSizes": [
        {
          "slug": "tiny",
          "size": "0.75rem",
          "name": "Tiny"
        },
        {
          "slug": "small",
          "size": "0.9375rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "medium",
          "size": "1.125rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "2rem",
          "name": "Large"
        },
        {
          "slug": "xlarge",
          "size": "2.25rem",
          "name": "Extra Large"
        },
        {
          "slug": "huge",
          "size": "3rem",
          "name": "Huge"
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "\"Open Sans\", Arial, Helvetica, sans-serif",
          "slug": "open-sans",
          "name": "Open Sans"
        },
        {
          "fontFamily": "\"Ubuntu\", Arial, Helvetica, sans-serif",
          "slug": "ubuntu",
          "name": "Ubuntu"
        }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ],
      "customSpacingSize": true
    },
    "custom": {
      "spacing": {
        "small": "1rem",
        "medium": "2rem",
        "large": "3rem"
      },
      "border": {
        "radius": "3px",
        "width": "3px"
      },
      "transition": {
        "duration": "0.3s",
        "timing": "ease-in-out"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--black)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--open-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--secondary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary)"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ubuntu)",
          "fontSize": "var(--wp--preset--font-size--huge)",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ubuntu)",
          "fontSize": "var(--wp--preset--font-size--xlarge)",
          "lineHeight": "1.3",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ubuntu)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.4",
          "fontWeight": "700"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ubuntu)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.4",
          "fontWeight": "700"
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "var(--wp--custom--border--radius)",
          "width": "var(--wp--custom--border--width)"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ubuntu)",
          "fontWeight": "700",
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "core/navigation": {
        "typography": {
          "fontWeight": "500",
          "fontSize": "var(--wp--preset--font-size--small)",
          "textTransform": "uppercase"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--ubuntu)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "color": "var(--wp--preset--color--primary)"
        }
      },
      "core/post-excerpt": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)",
          "lineHeight": "1.6"
        }
      },
      "core/query-pagination": {
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "var(--wp--preset--color--white)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)"
          }
        }
      }
    }
  }
}
